@page
@model OpenClaw.Console.Pages.DesktopModel
@{
    var vmName = Model.SelectedVm ?? "";
    ViewData["Title"] = string.IsNullOrEmpty(vmName) ? "远程桌面" : $"桌面: {vmName}";
}

@if (string.IsNullOrEmpty(vmName))
{
    <div class="alert alert-warning mt-3">未指定 Agent，请从<a asp-page="/Operations">运维页面</a>点击「桌面」按钮进入。</div>
    return;
}

@{
    var selectedRecord = Model.VmRecords.FirstOrDefault(v => v.Name == vmName);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <h4 class="mb-0 me-3">🖥️ @vmName</h4>
        @if (selectedRecord != null)
        {
            <span class="badge @selectedRecord.StatusBadgeClass me-2">@selectedRecord.Status</span>
            <small class="text-muted">@selectedRecord.VmIp</small>
        }
    </div>
    <a asp-page="/Operations" class="btn btn-sm btn-outline-secondary">← 返回运维</a>
</div>

<div id="desktop-loading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status"></div>
    <p class="mt-2 text-muted">正在连接远程桌面，即将跳转...</p>
</div>
<div id="desktop-error" class="alert alert-warning d-none">
    <strong>无法连接远程桌面</strong>
    <p class="mb-0 mt-1">该 Agent 可能未配置远程桌面服务，或 Guacamole 连接不可用。</p>
    <a asp-page="/Operations" class="btn btn-outline-secondary mt-2">← 返回运维</a>
</div>

@section Scripts {
<script>
(function() {
    var vmName = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(vmName))';
    var guacBase = '/guac/';
    var tokenUrl = guacBase + 'api/tokens';

    var loading = document.getElementById('desktop-loading');
    var errorDiv = document.getElementById('desktop-error');

    function showError(msg) {
        loading.classList.add('d-none');
        errorDiv.classList.remove('d-none');
        if (msg) {
            errorDiv.querySelector('p').textContent = msg;
        }
    }

    // Step 1: Get encrypted JSON auth data from Console API
    fetch('/api/desktop/token?vm=' + encodeURIComponent(vmName))
    .then(function(resp) {
        if (!resp.ok) return resp.json().then(function(e) { throw new Error(e.error || 'HTTP ' + resp.status); });
        return resp.json();
    })
    .then(function(result) {
        var encryptedData = result.data;
        var connectionName = result.connection;

        // Step 2: Send encrypted data to Guacamole to get auth token
        return fetch(tokenUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'data=' + encodeURIComponent(encryptedData)
        })
        .then(function(resp) {
            if (!resp.ok) throw new Error('Guacamole 认证失败 (HTTP ' + resp.status + ')');
            return resp.json();
        })
        .then(function(tokenData) {
            // Step 3: Redirect to Guacamole client (data source = "json")
            var clientId = btoa(connectionName + '\0c\0json');
            var clientUrl = guacBase + '#/client/' + clientId +
                '?token=' + encodeURIComponent(tokenData.authToken);
            window.location.href = clientUrl;
        });
    })
    .catch(function(err) {
        showError(err.message || '连接远程桌面时发生错误');
    });
})();
</script>
}
