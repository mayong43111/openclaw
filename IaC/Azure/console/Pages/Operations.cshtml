<!-- Create Agent Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">创建新 Agent</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="imageName" class="form-label">虚拟机镜像</label>
                        <select name="imageName" id="imageName" class="form-select" required>
                            @if (Model.Images.Count == 0)
                            {
                                <option value="" disabled selected>无可用镜像</option>
                            }
                            else
                            {
                                @foreach (var img in Model.Images)
                                {
                                    <option value="@img.Name">@img.DisplayName (@img.OsType)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="tag" class="form-label">标签 (Tag)</label>
                        <input type="text" name="tag" id="tag" class="form-control" placeholder="例如: production, staging, test"
                               list="tagSuggestions">
                        <datalist id="tagSuggestions">
                            @foreach (var t in Model.AllTags)
                            {
                                <option value="@t">@t</option>
                            }
                        </datalist>
                        <div class="form-text">可选。用于分组管理和批量推送配置。</div>
                    </div>
                    <p class="text-muted">将异步创建一个新的 OpenClaw Agent。
                        名称和管理员密码将自动生成。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" @(Model.Images.Count == 0 ? "disabled" : "")>创建</button>
                </div>
            </form>
        </div>
    </div>
</div>
