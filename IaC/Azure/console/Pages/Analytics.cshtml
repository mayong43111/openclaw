@page
@model OpenClaw.Console.Pages.AnalyticsModel
@{
    ViewData["Title"] = "运营分析展示";
    var maxMessages = Model.DailyStats.Count > 0 ? Model.DailyStats.Max(d => d.Messages) : 1;
    var totalModelTokens = Model.ModelStats.Sum(m => m.Tokens);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📊 运营分析展示</h2>
    <div class="d-flex gap-2 align-items-center">
        <span class="text-muted">统计周期：近 7 天</span>
        @if (Model.ActiveVmCount > 0)
        {
            <span class="badge bg-success">@Model.ActiveVmCount 台响应</span>
        }
        @if (Model.ReadyVmCount > Model.ActiveVmCount)
        {
            <span class="badge bg-warning text-dark">@(Model.ReadyVmCount - Model.ActiveVmCount) 台未响应</span>
        }
        <span class="badge bg-secondary">共 @Model.TotalVmCount 台</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<!-- KPI Overview -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">消息总数</p>
                        <h3 class="card-title mb-0">@Model.TotalMessages.ToString("N0")</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">💬</div>
                </div>
                <small style="opacity:0.8">工具调用 @Model.TotalToolCalls.ToString("N0") 次</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">会话数</p>
                        <h3 class="card-title mb-0">@Model.SessionCount.ToString("N0")</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">🗂️</div>
                </div>
                <small style="opacity:0.8">来自 @Model.ActiveVmCount 台 VM</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">Token 消耗</p>
                        <h3 class="card-title mb-0">@FormatTokens(Model.TotalTokens)</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">🔤</div>
                </div>
                <small style="opacity:0.8">平均延迟 @FormatLatency(Model.AvgLatencyMs)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">API 费用</p>
                        <h3 class="card-title mb-0">$@Model.TotalCostUsd.ToString("F2")</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">💰</div>
                </div>
                <small>错误率 <span
                    class="@(Model.GlobalErrorRate > 5 ? "text-danger" : "")">@Model.GlobalErrorRate.ToString("F1")%</span></small>
                </div>
            </div>
        </div>
    </div>

    <!-- Usage Trends + Model Distribution -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header">
                    <strong>📈 每日活动趋势 (7 天)</strong>
                </div>
                <div class="card-body">
                    @if (Model.DailyStats.Count == 0)
                    {
                        <div class="text-muted text-center py-5">暂无每日数据</div>
                    }
                    else
                    {
                        <!-- CSS bar chart -->
                        <div class="d-flex align-items-end justify-content-around" style="height:200px; margin-bottom:0.5rem;">
                            @foreach (var day in Model.DailyStats)
                            {
                                var barHeight = maxMessages > 0 ? (int)(day.Messages * 190.0 / maxMessages) + 10 : 10;
                                var opacity = maxMessages > 0 ? 0.4 + day.Messages * 0.6 / maxMessages : 0.5;
                                <div class="text-center" style="flex:1; max-width:60px;">
                                    <div class="bg-primary rounded-top mx-auto"
                                         style="width:36px;height:@(barHeight)px;opacity:@opacity.ToString("F2")"></div>
                                </div>
                            }
                        </div>
                        <div class="d-flex justify-content-around">
                            @foreach (var day in Model.DailyStats)
                            {
                                <div class="text-center" style="flex:1; max-width:60px;">
                                    <small class="text-muted d-block">@day.Label</small>
                                    <small>@day.Messages.ToString("N0")</small>
                                </div>
                            }
                        </div>
                        <!-- Daily detail table -->
                        <table class="table table-sm mt-3 mb-0" style="font-size:0.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>日期</th>
                                    <th class="text-end">消息</th>
                                    <th class="text-end">工具调用</th>
                                    <th class="text-end">Token</th>
                                    <th class="text-end">费用</th>
                                    <th class="text-end">错误</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in Model.DailyStats)
                                {
                                    <tr>
                                        <td>@day.Date</td>
                                        <td class="text-end">@day.Messages.ToString("N0")</td>
                                        <td class="text-end">@day.ToolCalls.ToString("N0")</td>
                                        <td class="text-end">@FormatTokens(day.Tokens)</td>
                                        <td class="text-end">$@day.Cost.ToString("F3")</td>
                                        <td class="text-end @(day.Errors > 0 ? "text-danger" : "")">@day.Errors</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header"><strong>🏷️ 模型使用分布</strong></div>
                <div class="card-body">
                    @if (Model.ModelStats.Count == 0)
                    {
                        <div class="text-muted text-center py-3">暂无模型数据</div>
                    }
                    else
                    {
                        var progressColors = new[] { "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger",
                "bg-secondary" };
                        var idx = 0;
                        @foreach (var m in Model.ModelStats.Take(6))
                        {
                            var pct = totalModelTokens > 0 ? (double)m.Tokens / totalModelTokens * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span style="font-size:0.9rem;">@m.DisplayName</span>
                                    <strong>@pct.ToString("F0")%</strong>
                                </div>
                                <div class="progress" style="height:12px;">
                                    <div class="progress-bar @progressColors[idx % progressColors.Length]"
                                         style="width:@pct.ToString("F1")%;"></div>
                                </div>
                                <small class="text-muted">@m.ApiCalls 次调用 · $@m.Cost.ToString("F3")</small>
                            </div>
                            idx++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Per-VM Performance -->
    <div class="card mb-4">
        <div class="card-header"><strong>🏆 VM 绩效排名</strong></div>
        <div class="card-body p-0">
            @if (Model.VmPerformances.Count == 0)
            {
                <div class="text-muted text-center py-3">暂无 VM 绩效数据</div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>VM</th>
                            <th class="text-end">会话</th>
                            <th class="text-end">消息</th>
                            <th class="text-end">工具调用</th>
                            <th>成功率</th>
                            <th class="text-end">平均延迟</th>
                            <th class="text-end">Token</th>
                            <th class="text-end">费用</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rank = 0;
                            var medals = new[] { "🥇", "🥈", "🥉" };
                        }
                        @foreach (var vm in Model.VmPerformances)
                        {
                            rank++;
                            <tr>
                                <td>
                                    @if (rank <= 3)
                                    {
                                        <span class="badge bg-warning text-dark">@medals[rank - 1]</span>
                                    }
                                    else
                                    {
                                        @rank
                                    }
                                </td>
                                <td><code>@vm.VmName</code></td>
                                <td class="text-end">@vm.SessionCount</td>
                                <td class="text-end">@vm.TotalMessages.ToString("N0")</td>
                                <td class="text-end">@vm.ToolCalls.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height:8px;">
                                            <div class="progress-bar @(vm.SuccessRate >= 95 ? "bg-success" : vm.SuccessRate >= 85 ? "bg-warning" : "bg-danger")"
                                                 style="width:@vm.SuccessRate.ToString("F0")%;"></div>
                                        </div>
                                        <small>@vm.SuccessRate.ToString("F0")%</small>
                                    </div>
                                </td>
                                <td class="text-end">@vm.FormattedLatency</td>
                                <td class="text-end">@FormatTokens(vm.TotalTokens)</td>
                                <td class="text-end">$@vm.TotalCost.ToString("F3")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- ROI + Business KPI (static demo) -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>💰 ROI 计算总结</strong>
                    <span class="badge bg-secondary">示例数据</span>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Total Hours Saved (Monthly)</td>
                                <td class="text-end"><strong>486 hours</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Average Hourly Cost (Employee)</td>
                                <td class="text-end"><strong>¥375/hr</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Gross Labor Savings</td>
                                <td class="text-end"><strong class="text-success">¥182,250</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">AI Infrastructure Cost</td>
                                <td class="text-end"><strong class="text-danger">-¥45,600</strong></td>
                            </tr>
                            <tr class="table-success">
                                <td><strong>Net Monthly Savings</strong></td>
                                <td class="text-end"><strong class="text-success" style="font-size:1.2em;">¥136,650</strong>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">ROI Ratio</td>
                                <td class="text-end"><strong class="text-success">299%</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>📋 业务 KPI 影响</strong>
                    <span class="badge bg-secondary">示例数据</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Code Review Turnaround</span>
                            <span class="text-success">↓ 60% (4h → 1.5h)</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-success" style="width:60%;"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Customer Response Time</span>
                            <span class="text-success">↓ 45% (30min → 16min)</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-success" style="width:45%;"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Report Generation Speed</span>
                            <span class="text-success">↓ 80% (2h → 25min)</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-success" style="width:80%;"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Employee Satisfaction</span>
                            <span class="text-success">↑ 22% (NPS: 45 → 55)</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-info" style="width:22%;"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Bug Discovery Rate</span>
                            <span class="text-success">↑ 35%</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-info" style="width:35%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@functions {
    static string FormatTokens(long tokens)
    {
        return tokens switch
        {
            >= 1_000_000 => $"{tokens / 1_000_000.0:F1}M",
            >= 1_000 => $"{tokens / 1_000.0:F1}K",
            _ => tokens.ToString("N0"),
        };
    }

    static string FormatLatency(double ms)
    {
        return ms switch
        {
            >= 1000 => $"{ms / 1000:F1}s",
            > 0 => $"{ms:F0}ms",
            _ => "—",
        };
    }
}
