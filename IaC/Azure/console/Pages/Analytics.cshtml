            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted">Total Hours Saved (Monthly)</td>
                            <td class="text-end"><strong>486 hours</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Average Hourly Cost (Employee)</td>
                            <td class="text-end"><strong>¥375/hr</strong></td>
                        </tr>
