@page
@model OpenClaw.Console.Pages.AnalyticsModel
@{
    ViewData["Title"] = "运营分析展示";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📊 运营分析展示</h2>
    <div class="d-flex gap-2 align-items-center">
        <select class="form-select form-select-sm" style="width:150px;" disabled>
            <option selected>近 7 天</option>
            <option>近 30 天</option>
            <option>近 90 天</option>
            <option>自定义范围</option>
        </select>
        <button class="btn btn-outline-primary btn-sm" disabled>
            <span class="me-1">📤</span> 导出报告
        </button>
    </div>
</div>

<!-- KPI Overview -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">自动化操作</p>
                        <h3 class="card-title mb-0">12,847</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">🤖</div>
                </div>
                <small style="opacity:0.8">↑ 23% vs last week</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">节省工时</p>
                        <h3 class="card-title mb-0">486h</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">⏱️</div>
                </div>
                <small style="opacity:0.8">↑ 15% vs last week</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">效率提升</p>
                        <h3 class="card-title mb-0">34%</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">📈</div>
                </div>
                <small style="opacity:0.8">↑ 5pp vs last month</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="card-text mb-1" style="opacity:0.8">预估 ROI</p>
                        <h3 class="card-title mb-0">¥182K</h3>
                    </div>
                    <div style="font-size:2.5rem;opacity:0.3">💰</div>
                </div>
                <small>Monthly cost savings</small>
            </div>
        </div>
    </div>
</div>

